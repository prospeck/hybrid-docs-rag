# Safe defaults use free local components. Copy to .env only if desired.
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_GENERATION_PROVIDER=ollama
RAG_GENERATION_MODEL=llama3.2:3b
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_VECTOR_BACKEND=chroma
RAG_CHROMA_HOST=
RAG_CHROMA_PORT=8000
RAG_CHUNK_STRATEGY=recursive
RAG_DENSE_WEIGHT=0.7
RAG_SPARSE_WEIGHT=0.3
RAG_RERANKER_ENABLED=true

# Optional paid/provider-backed adapters; never required by the default setup.
# OPENAI_API_KEY=
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_GENERATION_MODEL=gpt-4o-mini
